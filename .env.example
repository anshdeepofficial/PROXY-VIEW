# Local development only. Vercel supplies PORT/HOST automatically.
PORT=3000
HOST=127.0.0.1

SESSION_TIMEOUT_MINUTES=20
DISCONNECT_GRACE_SECONDS=45
MAX_SESSIONS=2
MAX_PAGES_PER_SESSION=4
NAVIGATION_TIMEOUT_MS=30000
MAX_VIEWPORT_WIDTH=1920
MAX_VIEWPORT_HEIGHT=1080

# Optional. If empty, browsing uses the hosting server's normal internet connection.
PROXY_MODE=none
PROXY_URL=

# Optional proxy pool as a JSON array. Credentials stay server-side.
# Example:
# PROXY_MODE=pool
# PROXY_POOL=["http://user:pass@proxy1.example:8080","socks5://proxy2.example:1080"]
PROXY_POOL=[]

# Local-only override. Usually leave empty after running:
# npx playwright install chromium
CHROMIUM_EXECUTABLE_PATH=

# Set automatically by Vercel. For another serverless Linux host, set to 1
# to use @sparticuz/chromium.
SERVERLESS_CHROMIUM=0

# Remote viewport stream quality.
# 2x is the recommended balance for mobile sharpness and low-latency scrolling.
MAX_STREAM_DPR=2
STREAM_JPEG_QUALITY=82
STREAM_MAX_FPS=30
STREAM_SOCKET_BUFFER_BYTES=450000

# Maximum size for one upload/download transfer through the remote session (25 MB default).
MAX_TRANSFER_BYTES=26214400
